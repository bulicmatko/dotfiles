#!/usr/bin/env bash
#
# dotfiles-doctor — verify this machine matches the repo:
# every symlink points into the dotfiles, local override files and git
# identity exist, the shell components are installed, the Brewfile is
# satisfied, and no forgotten *.backup.* files are lying around.
#
# Exits non-zero when configuration is broken (missing/wrong symlinks or
# identity); informational findings (pending updates, backups) do not fail.

set -euo pipefail
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$DOTFILES_DIR/scripts/lib.sh"

# Checks follow the same target split as the installers (the devcontainer
# target is a headless subset: shell, prompt, and git only).
TARGET="$(detect_target)"
PROBLEMS=0

# check_link <repo-relative-source> <absolute-target>
check_link() {
  local src="$DOTFILES_DIR/$1" dst="$2"
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    ok "$dst"
  elif [ -L "$dst" ]; then
    warn "$dst points to $(readlink "$dst") — expected $src"
    PROBLEMS=$((PROBLEMS + 1))
  elif [ -e "$dst" ]; then
    warn "$dst exists but is not a symlink — run ./install.sh"
    PROBLEMS=$((PROBLEMS + 1))
  else
    warn "$dst missing — run ./install.sh"
    PROBLEMS=$((PROBLEMS + 1))
  fi
}

info "dotfiles: $DOTFILES_DIR (target: $TARGET)"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
info "symlinks"
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# The pairs come from the shared manifest in scripts/lib.sh, so this check
# always matches exactly what the installer links for this target.
while IFS=$'\t' read -r src dst; do
  check_link "$src" "$dst"
done <<EOF
$(dotfiles_links "$TARGET")
EOF

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
info "local overrides + git identity"
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# ~/.ssh/config.local is only created by the macOS/Linux installers (the
# devcontainer target gets SSH via agent forwarding, no config link).
OVERRIDES=("$HOME/.gitconfig.local")
if [ "$TARGET" != "devcontainer" ]; then
  OVERRIDES=("${OVERRIDES[@]}" "$HOME/.ssh/config.local")
fi
for f in "${OVERRIDES[@]}"; do
  if [ -f "$f" ]; then ok "$f"; else
    warn "$f missing — run ./install.sh"
    PROBLEMS=$((PROBLEMS + 1))
  fi
done
if [ -f "$HOME/.zshrc.local" ]; then
  ok "$HOME/.zshrc.local (optional)"
else
  info "no ~/.zshrc.local (optional)"
fi

name="$(git config --file "$HOME/.gitconfig.local" user.name 2>/dev/null || true)"
email="$(git config --file "$HOME/.gitconfig.local" user.email 2>/dev/null || true)"
if [ -n "$name" ] && [ -n "$email" ]; then
  ok "git identity: $name <$email>"
else
  warn "git identity incomplete — set it in ~/.gitconfig.local"
  PROBLEMS=$((PROBLEMS + 1))
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
info "shell components"
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

custom="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
COMPONENTS=("$HOME/.oh-my-zsh"
            "$custom/plugins/zsh-autosuggestions"
            "$custom/plugins/zsh-syntax-highlighting")
# nvm is only installed by the macOS/Linux installers (containers bring
# their own Node via the image).
if [ "$TARGET" != "devcontainer" ]; then
  COMPONENTS=("${COMPONENTS[@]}" "$HOME/.nvm")
fi
for d in "${COMPONENTS[@]}"; do
  if [ -d "$d" ]; then ok "${d##*/}"; else
    warn "${d##*/} missing — run ./install.sh"
    PROBLEMS=$((PROBLEMS + 1))
  fi
done
if command -v starship >/dev/null 2>&1; then ok "starship"; else
  warn "starship missing — run ./install.sh"
  PROBLEMS=$((PROBLEMS + 1))
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
info "homebrew (informational)"
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

if command -v brew >/dev/null 2>&1; then
  # This machine's picker selection wins over the full catalog, so a
  # deliberately trimmed install is never reported as unhealthy.
  if [ -f "$HOME/.Brewfile.local" ]; then
    BREWFILE="$HOME/.Brewfile.local"
  else
    BREWFILE="$DOTFILES_DIR/Brewfile"
  fi
  if brew bundle check --file="$BREWFILE" >/dev/null 2>&1; then
    ok "$(basename "$BREWFILE") satisfied"
  else
    warn "$(basename "$BREWFILE") has missing or outdated entries — run dotfiles-update"
  fi
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
info "leftover backups (informational)"
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Scan every directory the installer links into (derived from the manifest,
# plus $HOME itself) so no backup location is ever missed.
backups="$(
  {
    printf '%s\n' "$HOME"
    dotfiles_links macos | while IFS=$'\t' read -r _ dst; do dirname "$dst"; done
  } | sort -u | while IFS= read -r dir; do
        find "$dir" -maxdepth 1 -name "*.backup.*" 2>/dev/null || true
      done | sort -u
)"
if [ -n "$backups" ]; then
  printf '%s\n' "$backups" | while IFS= read -r b; do info "backup: $b"; done
else
  ok "no leftover backups"
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
printf '\n'
if [ "$PROBLEMS" -eq 0 ]; then
  ok "this machine is healthy"
else
  fail "$PROBLEMS problem(s) found — ./install.sh fixes most of them"
fi

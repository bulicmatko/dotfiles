# ~/.ssh/config — managed by https://github.com/bulicmatko/dotfiles

# Applies to every host.
Host *
    # UseKeychain is a macOS-only option; this line tells Linux ssh to skip
    # it instead of rejecting the whole config file.
    IgnoreUnknown UseKeychain
    # macOS: read/store the key passphrase in the Apple keychain.
    UseKeychain yes
    # Load the key into ssh-agent automatically on first use.
    AddKeysToAgent yes
    # Default identity (generated by the install script if missing).
    IdentityFile ~/.ssh/id_ed25519

// Zed settings — symlinked to ~/.config/zed/settings.json by ./install.sh.
// Every option carries a short comment. Docs: https://zed.dev/docs/configuring-zed
{
  // Fonts tried when the main font misses a glyph.
  "buffer_font_fallbacks": ["FiraCode Nerd Font", "Monaco"],
  // Highlight .dockerignore like a shell script (comments, globs).
  "file_types": {
    "Shell Script": [".dockerignore"],
  },
  // Format every file on save.
  "format_on_save": "on",
  // Two-space indentation.
  "tab_size": 2,
  // Font size of the markdown preview pane.
  "markdown_preview": {
    "font_size": 13.0,
  },
  // External agent available in the agent panel: Claude Code via ACP.
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "effort": "default",
        "model": "default",
      },
      "type": "registry",
    },
  },
  // `zed <path>` from the terminal opens a new window.
  "cli_default_open_behavior": "new_window",
  // Closing the last tab keeps the window open.
  "when_closing_with_no_tabs": "keep_window_open",
  // Use VSCode-style default shortcuts as the base keymap.
  "base_keymap": "VSCode",
  // Extensions Zed installs by itself on first launch, so a new machine has
  // them without a trip through the extension list. The theme below comes
  // from one of them: naming a theme Zed does not have installed leaves it
  // on its default instead.
  "auto_install_extensions": {
    "astro": true,
    "docker-compose": true,
    "dockerfile": true,
    "html": true,
    "sql": true,
    "terraform": true,
    "tokyo-night": true,
    "toml": true,
    "xml": true,
  },
  // Theme: Tokyo Night Storm, whatever the system appearance.
  "theme": "Tokyo Night Storm",
  // Darker background variant + unified hover/selection tint (#1f2335 /
  // #2c324a) to match the VSCode and Warp customizations.
  "theme_overrides": {
    "Tokyo Night Storm": {
      "editor.background": "#1f2335",
      "editor.gutter.background": "#1f2335",
      "tab.active_background": "#2c324a",
      "tab.inactive_background": "#1f2335",
      "ghost_element.background": "#1f2335",
      "ghost_element.hover": "#2c324a",
      "ghost_element.selected": "#2c324a",
      "element.hover": "#2c324a",
      "element.selected": "#2c324a",
    },
  },
  // Show the git branch status icon in the title bar.
  "title_bar": {
    "show_branch_status_icon": true,
  },
  // Tabs: color by git status, show error/warning dots, no close button.
  "tabs": {
    "git_status": true,
    "show_diagnostics": "all",
    "show_close_button": "hidden",
  },
  // Quick-fix (code action) button in the toolbar.
  "toolbar": {
    "code_actions": true,
  },
  // Show diagnostics inline at the end of the line (like Error Lens).
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  // UI font and size.
  "ui_font_family": "MonaspiceAr NF",
  "ui_font_size": 16.0,
  // Editor font — Monaspice (Nerd Font build of Monaspace Argon).
  "buffer_font_family": "MonaspiceAr NF",
  // Enable all Monaspace ligature/stylistic sets (arrows, ===, etc.).
  "buffer_font_features": {
    "calt": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true,
    "ss09": true,
    "liga": true,
  },
  // Small editor font with double line height (matches VSCode).
  "buffer_font_size": 13.0,
  "buffer_line_height": {
    "custom": 2.0,
  },
  // Vertical guide lines at 80 and 100 characters.
  "wrap_guides": [80, 100],
  // Indent guides colored per indentation level.
  "indent_guides": {
    "coloring": "indent_aware",
  },
  // Render spaces/tabs as visible dots/arrows.
  "show_whitespaces": "all",
  // Search is case-insensitive until the query has an uppercase letter.
  "use_smartcase_search": true,
  // File tree: left dock, 400px, folders never auto-collapse into a/b/c.
  "project_panel": {
    "dock": "left",
    "default_width": 400.0,
    "auto_fold_dirs": false,
  },
  // Inline git blame shows the commit summary text too.
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  // Git panel: left dock, tree view grouped by staging, status shown by
  // coloring the file label.
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "group_by": "staging",
    "status_style": "label_color",
    "default_width": 400,
  },
  // Terminal: right dock, 800px, blinking cursor, small font, double line
  // height.
  "terminal": {
    "blinking": "on",
    "dock": "right",
    "default_width": 800,
    "font_size": 13.0,
    "line_height": {
      "custom": 2.0,
    },
  },
  // Built-in AI agent panel: fully disabled (button hidden).
  "agent": {
    "button": false,
    "enabled": false,
  },
  // TypeScript/JavaScript (vtsls): update imports when a file moves.
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
    },
  },
  // Telemetry: no usage metrics (crash diagnostics stay on).
  "telemetry": {
    "metrics": false,
  },
}

# ~/.zshrc — managed by https://github.com/bulicmatko/dotfiles
# Machine-specific additions belong in ~/.zshrc.local (sourced at the end).

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Homebrew
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Put brew on PATH and export its env vars, whichever install location exists.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"     # macOS Apple Silicon
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"        # macOS Intel
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Dotfiles
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Locate the repo by resolving this file's symlink (%x = file being sourced),
# and put its bin/ on PATH — any script dropped there exists on every machine.
export DOTFILES="${${(%):-%x}:A:h:h}"
export PATH="$DOTFILES/bin:$PATH"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# oh-my-zsh
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Skip oh-my-zsh's "insecure completion directories" check (slow, and noisy
# on Homebrew-managed completion dirs).
ZSH_DISABLE_COMPFIX="true"

# Where oh-my-zsh is installed (by scripts/lib.sh:setup_zsh).
export ZSH="$HOME/.oh-my-zsh"

# No oh-my-zsh theme — the prompt is starship (initialized at the end of
# this file, configured in settings/starship/starship.toml).
ZSH_THEME=""

# Tab completion treats - and _ as the same character.
HYPHEN_INSENSITIVE="true"
# Offer to auto-correct mistyped commands ("zhs" -> "zsh"?).
ENABLE_CORRECTION="true"

# Plugins loaded by oh-my-zsh:
#   git                     — g* aliases (gst, gco, gp, ...) for common git commands
#   zsh-autosuggestions     — inline gray suggestion from history; right-arrow accepts
#   zsh-syntax-highlighting — valid commands green, typos red, as you type
#                             (must stay last in this list)
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# Guarded so a shell still starts (without plugins/aliases) if oh-my-zsh is
# missing — ./install.sh restores it.
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# History
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

HISTSIZE=100000                # lines kept in memory
SAVEHIST=100000                # lines kept in ~/.zsh_history
setopt SHARE_HISTORY           # share history live across all open terminals
setopt HIST_IGNORE_ALL_DUPS    # a repeated command keeps only its newest entry
setopt HIST_IGNORE_SPACE       # commands starting with a space are not saved
setopt HIST_REDUCE_BLANKS      # strip superfluous whitespace before saving

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Shell extras
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# fzf — fuzzy Ctrl-R history search, Ctrl-T file picker, **<Tab> completion.
if command -v fzf >/dev/null 2>&1; then
  if fzf --zsh >/dev/null 2>&1; then
    eval "$(fzf --zsh)"
  elif [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
    source /usr/share/doc/fzf/examples/key-bindings.zsh   # older apt versions
  fi
fi

# zoxide — learned cd: `z <part-of-path>` jumps to the best match.
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Prompt
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# starship — fast cross-shell prompt, configured in ~/.config/starship.toml
# (symlinked from settings/starship/starship.toml).
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# SSH keys
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# macOS needs nothing here: ~/.ssh/config (AddKeysToAgent + UseKeychain) loads
# the key from the Apple keychain on first use.
# Linux: keychain reuses one ssh-agent across sessions, so the passphrase is
# asked once per boot instead of once per shell.
if [[ "$OSTYPE" != darwin* ]] && command -v keychain >/dev/null 2>&1; then
  eval "$(keychain --eval --quiet id_ed25519 2>/dev/null)"
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Toolchains
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# nvm — Node version manager (installed into ~/.nvm by the install script).
# Sourced with --no-use so startup skips nvm's own version activation; the
# load-nvmrc hook below picks the right version once instead.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Auto-switch Node versions when entering a directory with .nvmrc — nvm's
# documented zsh integration, plus a default-version branch (needed with
# --no-use above) so shells without a .nvmrc still get Node on PATH.
if command -v nvm >/dev/null 2>&1; then
  autoload -U add-zsh-hook

  load-nvmrc() {
    local nvmrc_path
    nvmrc_path="$(nvm_find_nvmrc)"

    if [ -n "$nvmrc_path" ]; then
      local nvmrc_node_version
      nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")

      if [ "$nvmrc_node_version" = "N/A" ]; then
        nvm install
      elif [ "$nvmrc_node_version" != "$(nvm version)" ]; then
        nvm use
      fi
    elif [ "$(nvm current)" = "none" ]; then
      nvm use default --silent
    elif [ -n "$(PWD=$OLDPWD nvm_find_nvmrc)" ] && [ "$(nvm version)" != "$(nvm version default)" ]; then
      echo "Reverting to nvm default version"
      nvm use default
    fi
  }

  add-zsh-hook chpwd load-nvmrc
  load-nvmrc
fi

# deno — binaries installed by `deno install` land in ~/.deno/bin.
export DENO_INSTALL="$HOME/.deno"
export PATH="$DENO_INSTALL/bin:$PATH"

# bun — PATH for curl-installed bun (Linux); brew handles it on macOS.
export BUN_INSTALL="$HOME/.bun"
[[ -d "$BUN_INSTALL/bin" ]] && export PATH="$BUN_INSTALL/bin:$PATH"
# bun shell completions, if generated.
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Aliases
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

alias -- -="cd -"      # `-` jumps back to the previous directory
alias ..="cd .."
alias ...="cd ../.."

alias c="clear"

# Long listings — eza (git-aware, icons, dirs first) when installed, else ls.
if command -v eza >/dev/null 2>&1; then
  alias lsl="eza -l --git --icons --group-directories-first"
  alias lsal="eza -la --git --icons --group-directories-first"
else
  alias lsl="ls -lF"
  alias lsal="ls -alF"
fi

# Trailing space makes the word after sudo expand as an alias too.
alias sudo="sudo "

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Miscellaneous
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Default editor for git, crontab, etc. — VSCode where available (--wait
# blocks until the file is closed, which git needs), otherwise vim/vi on
# headless machines.
if command -v code >/dev/null 2>&1; then
  export EDITOR="code --wait"
elif command -v vim >/dev/null 2>&1; then
  export EDITOR="vim"
else
  export EDITOR="vi"
fi
export VISUAL="$EDITOR"

# Editor that React/Next error overlays open files in.
export REACT_EDITOR="code"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Machine-local overrides (not tracked in the repo)
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# The || true keeps a missing (optional) file from leaving $? = 1, which
# would paint the very first prompt in its error state.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local" || true

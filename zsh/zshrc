# ~/.zshrc — managed by https://github.com/bulicmatko/dotfiles
# Machine-specific additions belong in ~/.zshrc.local (sourced at the end).

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Homebrew
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Put brew on PATH and export its env vars, whichever install location exists.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"     # macOS Apple Silicon
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"        # macOS Intel
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# oh-my-zsh + spaceship
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Skip oh-my-zsh's "insecure completion directories" check (slow, and noisy
# on Homebrew-managed completion dirs).
ZSH_DISABLE_COMPFIX="true"

# Where oh-my-zsh is installed (by scripts/lib.sh:setup_zsh).
export ZSH="$HOME/.oh-my-zsh"

# Prompt theme: spaceship (git branch/status, language versions, exit code).
ZSH_THEME="spaceship"
# Cactus instead of the default git branch symbol.
SPACESHIP_GIT_SYMBOL="🌵 "
# Render the prompt synchronously — no sections popping in after display.
SPACESHIP_PROMPT_ASYNC="false"

# Tab completion treats - and _ as the same character.
HYPHEN_INSENSITIVE="true"
# Offer to auto-correct mistyped commands ("zhs" -> "zsh"?).
ENABLE_CORRECTION="true"

# Plugins loaded by oh-my-zsh:
#   git                  — g* aliases (gst, gco, gp, ...) for common git commands
#   zsh-autosuggestions  — inline gray suggestion from history; right-arrow accepts
plugins=(
  git
  zsh-autosuggestions
)

source "$ZSH/oh-my-zsh.sh"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# SSH keys
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# macOS needs nothing here: ~/.ssh/config (AddKeysToAgent + UseKeychain) loads
# the key from the Apple keychain on first use.
# Linux: keychain reuses one ssh-agent across sessions, so the passphrase is
# asked once per boot instead of once per shell.
if [[ "$OSTYPE" != darwin* ]] && command -v keychain >/dev/null 2>&1; then
  eval "$(keychain --eval --quiet id_ed25519 2>/dev/null)"
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Toolchains
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# nvm — Node version manager (installed into ~/.nvm by the install script).
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Auto-switch Node versions when entering a directory with .nvmrc —
# nvm's own documented zsh integration.
if command -v nvm >/dev/null 2>&1; then
  autoload -U add-zsh-hook

  load-nvmrc() {
    local nvmrc_path
    nvmrc_path="$(nvm_find_nvmrc)"

    if [ -n "$nvmrc_path" ]; then
      local nvmrc_node_version
      nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")

      if [ "$nvmrc_node_version" = "N/A" ]; then
        nvm install
      elif [ "$nvmrc_node_version" != "$(nvm version)" ]; then
        nvm use
      fi
    elif [ -n "$(PWD=$OLDPWD nvm_find_nvmrc)" ] && [ "$(nvm version)" != "$(nvm version default)" ]; then
      echo "Reverting to nvm default version"
      nvm use default
    fi
  }

  add-zsh-hook chpwd load-nvmrc
  load-nvmrc
fi

# deno — binaries installed by `deno install` land in ~/.deno/bin.
export DENO_INSTALL="$HOME/.deno"
export PATH="$DENO_INSTALL/bin:$PATH"

# bun — PATH for curl-installed bun (Linux); brew handles it on macOS.
export BUN_INSTALL="$HOME/.bun"
[[ -d "$BUN_INSTALL/bin" ]] && export PATH="$BUN_INSTALL/bin:$PATH"
# bun shell completions, if generated.
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Aliases
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

alias -- -="cd -"      # `-` jumps back to the previous directory
alias ..="cd .."
alias ...="cd ../.."

alias c="clear"

alias lsl="ls -lF"     # long listing, / after dirs and * after executables
alias lsal="ls -alF"   # same, including dotfiles

# Trailing space makes the word after sudo expand as an alias too.
alias sudo="sudo "

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Miscellaneous
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Default editor for git, crontab, etc. — VSCode where available (--wait
# blocks until the file is closed, which git needs), otherwise vim/vi on
# headless machines.
if command -v code >/dev/null 2>&1; then
  export EDITOR="code --wait"
elif command -v vim >/dev/null 2>&1; then
  export EDITOR="vim"
else
  export EDITOR="vi"
fi
export VISUAL="$EDITOR"

# Editor that React/Next error overlays open files in.
export REACT_EDITOR="code"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Machine-local overrides (not tracked in the repo)
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# ~/.zshrc — managed by https://github.com/bulicmatko/dotfiles
# Machine-specific additions belong in ~/.zshrc.local (sourced at the end).

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Homebrew
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"     # macOS Apple Silicon
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"        # macOS Intel
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# oh-my-zsh + spaceship
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

ZSH_DISABLE_COMPFIX="true"

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="spaceship"
SPACESHIP_GIT_SYMBOL="🌵 "
SPACESHIP_PROMPT_ASYNC="false"

HYPHEN_INSENSITIVE="true"
ENABLE_CORRECTION="true"

# Enable nvm auto use — must be set before plugins (used by zsh-nvm).
export NVM_AUTO_USE="true"

# nvm is installed, loaded, and kept up to date by the zsh-nvm plugin.
plugins=(
  git
  zsh-nvm
  zsh-autosuggestions
)

source "$ZSH/oh-my-zsh.sh"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# SSH keys
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# macOS needs nothing here: ~/.ssh/config (AddKeysToAgent + UseKeychain) loads
# the key from the Apple keychain on first use.
# Linux: keychain reuses one ssh-agent across sessions.
if [[ "$OSTYPE" != darwin* ]] && command -v keychain >/dev/null 2>&1; then
  eval "$(keychain --eval --quiet id_ed25519 2>/dev/null)"
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Toolchains
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# asdf (only active once asdf has installed something)
[[ -d "$HOME/.asdf/shims" ]] && export PATH="$HOME/.asdf/shims:$PATH"

# deno
export DENO_INSTALL="$HOME/.deno"
export PATH="$DENO_INSTALL/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
[[ -d "$BUN_INSTALL/bin" ]] && export PATH="$BUN_INSTALL/bin:$PATH"
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"   # completions

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Aliases
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

alias -- -="cd -"
alias ..="cd .."
alias ...="cd ../.."

alias c="clear"

alias lsl="ls -lF"
alias lsal="ls -alF"

# Make aliases work behind sudo.
alias sudo="sudo "

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Miscellaneous
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

export REACT_EDITOR="code"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Machine-local overrides (not tracked in the repo)
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

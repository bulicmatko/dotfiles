# Editor defaults for files in THIS repo (editors pick it up automatically
# via the EditorConfig extension/support).
root = true

[*]
charset = utf-8
end_of_line = lf              # LF line endings everywhere
insert_final_newline = true   # files end with a newline
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Trailing spaces are meaningful in Markdown (two = line break).
[*.md]
trim_trailing_whitespace = false
